# Copy to .env (git-ignored) to override the dev defaults used by
# docker-compose.yml. All values here are non-secret local placeholders.

# ---- postgres -----------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=salvorion_dev          # must match config/dev.exs
POSTGRES_PORT=5432                 # host port mapped to the container

# Replication role + publication created by docker/postgres/init/01-powersync.sh
POWERSYNC_DB_USER=powersync
POWERSYNC_DB_PASSWORD=powersync
# Separate database (same server) used for PowerSync sync-bucket storage
POWERSYNC_STORAGE_DB=powersync_storage

# ---- powersync ----------------------------------------------------------
POWERSYNC_PORT=8080
# JWKS endpoint Phoenix will expose once Guardian is configured (RS256/ES256)
POWERSYNC_JWKS_URL=http://host.docker.internal:4000/.well-known/jwks.json

# ---- gotenberg ----------------------------------------------------------
GOTENBERG_PORT=3000
