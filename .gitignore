# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Temporary files, for example, from tests.
/tmp/

# Ignore package tarball (built via "mix hex.build").
salvorion-*.tar


# Local environment overrides (never commit secrets).
.env
.env.*
!.env.example

# Editors
.vscode/
!.vscode/settings.json
.idea/
*.swp
*.swo
*~
.elixir_ls/
.elixir-tools/

# macOS / Windows / WSL cruft
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
*:Zone.Identifier

# Claude Code per-user permissions
.claude/settings.local.json

# Guardian RS256 signing keys (dev keys are generated locally; never commit them)
/priv/keys/

# tools/powersync-verify (Prompt 10): a verification-only Node.js script,
# not part of the application. node_modules and the local SQLite mirrors
# it builds while testing sync scoping are dev artifacts, not source.
/tools/powersync-verify/node_modules/
/tools/powersync-verify/*.db
/tools/powersync-verify/*.db-wal
/tools/powersync-verify/*.db-shm

# Generated report PDFs (Prompt 11, Task 4): dev-only artefact storage.
# Production will need real object storage instead - see docs/DECISIONS.md.
# The directory itself stays tracked via .gitkeep.
/priv/generated_reports/*.pdf
